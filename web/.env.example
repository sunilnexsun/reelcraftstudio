# Copy to .env.local and fill in. Only VITE_* variables reach the browser —
# never put secrets (API keys, SMTP passwords) here.

# Public form-submission endpoint (e.g. https://formspree.io/f/xxxxxxx, or your own API route).
# Leave empty to keep the "not connected yet → send via WhatsApp" behaviour.
VITE_FORM_ENDPOINT=

# Set to true to show "Add … in src/data/site.ts" hints in a production build.
VITE_SHOW_PLACEHOLDERS=false

# ReelCraft Studio admin — copy to .env.local and fill in. Never commit real values.

# Supabase project URL and the PUBLISHABLE key (sb_publishable_… or the legacy anon key).
# These are safe in the browser: every table is protected by Row Level Security.
# NEVER put the service-role / secret key in any VITE_ variable — it would ship to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# demo | live — optional. Unset = live when the two values above exist, otherwise demo.
# VITE_DATA_MODE=demo
